# Virtual AI Interviewer — пример конфигурации (ТЗ §10, §11).
# Копируйте в .env и заполняйте локально. Секреты в репозиторий не коммитить.

# --- Backend ---
VAI_HOST=0.0.0.0
VAI_PORT=8000
VAI_LOG_LEVEL=info

# --- Режим AI (mock — без GPU, vllm — GPU в Yandex Cloud) ---
VAI_LLM_MODE=mock          # mock | vllm
VAI_TTS_MODE=mock          # mock | silero
VAI_ASR_MODE=mock          # mock | faster-whisper

# --- vLLM / Qwen3 ---
VAI_VLLM_BASE_URL=http://localhost:8001/v1
VAI_VLLM_MODEL=Qwen/Qwen3-8B
VAI_VLLM_API_KEY=

# --- PostgreSQL ---
VAI_DB_HOST=localhost
VAI_DB_PORT=5432
VAI_DB_NAME=virtual_interviewer
VAI_DB_USER=postgres
VAI_DB_PASSWORD=

# --- Безопасность ---
VAI_AUTH_TOKEN=
VAI_MAX_UPLOAD_MB=10
